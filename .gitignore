.venv/
__pycache__/
recon_*/
# NOTA: não use um `*.json` global — ele engoliria .claude/settings.json (config dos hooks).
# Os JSON de recon/estado já são cobertos por targets/*, recon_*/, reports/ e as regras do brain.

# brain = WAL local; estado canônico por alvo vive no Hive, só o índice versiona
brain/targets/
brain/techniques/
brain/patterns/
brain/sessions/
brain/circuit-breaker.json
brain/exhaustion/
brain/model/
!brain/MEMORY.md

# targets/ é scratch efêmero; conteúdo canônico de alvo vive no Hive Mind.
# Ignora tudo, menos o template de estrutura.
targets/*
!targets/_TEMPLATE/

# Recibos efêmeros de escopo/ingestão do Hive (nunca concedem autoridade por si).
.hive/

# recon cru e evidências por alvo (nunca commitar dado real de caçada aqui)
reports/
poc/

.DS_Store
**/.DS_Store
.claude/settings.local.json

# cofre de segredos por alvo (keys/cookies vivos). NUNCA versionar. Lido pelas tools via env-var.
.secrets/

# blob de transporte de segredos (gpg). NUNCA commitar salvo decisão explícita (risco B).
excalibull-secrets.tar.gz.gpg

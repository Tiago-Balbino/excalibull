{
  "version": 1,
  "id": "document-read-isolation",
  "program_id": "example",
  "profile": "cross-account-read",
  "hypothesis": "A sessão A pode ler o documento privado de teste da conta B.",
  "evidence_refs": ["owner-a-control", "owner-b-control", "private-sharing-reviewed"],
  "policy": {
    "reviewed": true,
    "automation_allowed": true,
    "owned_test_accounts": true,
    "private_objects": true,
    "scope_revision": "REPLACE_WITH_APPROVED_MIND_REVISION",
    "required_headers_env": "CARRASCO_REQUIRED_HEADERS"
  },
  "limits": {
    "requests": 6,
    "seconds": 90,
    "timeout": 10,
    "rate": 1,
    "response_bytes": 65536
  },
  "accounts": {
    "a": {
      "url": "https://app.example.invalid/api/documents/test-a",
      "headers_env": "CARRASCO_ACCOUNT_A",
      "marker": "carrasco-aaaaaaaa11111111"
    },
    "b": {
      "url": "https://app.example.invalid/api/documents/test-b",
      "headers_env": "CARRASCO_ACCOUNT_B",
      "marker": "carrasco-bbbbbbbb22222222"
    }
  },
  "assertion": {"json_pointer": "/content"}
}
